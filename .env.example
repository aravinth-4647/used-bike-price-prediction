# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# Connect your serverless Neon PostgreSQL instance here:
# Example: postgresql://username:password@ep-cool-mountain-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. FRONTEND URL (For CORS when running separately)
# In production on single Vercel deployment, this is optional
FRONTEND_URL=http://localhost:5173

# 3. VITE API BASE URL (Optional for custom backend host)
# Default is relative '/api' for same-origin Vercel deployment
VITE_API_URL=/api

# 4. LOCAL BACKEND PORT
PORT=8000
